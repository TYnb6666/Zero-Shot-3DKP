    "version": "0.2.0",
    "configurations": [
        {
            "name": "ZeroKey Eval - KeypointNet",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["eval", "zerokey", "--dataset", "keypointnet"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "ZeroKey Eval - RealScene",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["eval", "zerokey", "--dataset", "realscene"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "ZeroKey Eval - Human3M",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["eval", "zerokey", "--dataset", "human3m"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "Metric - IoU",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["metric", "iou"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1"
            }
        },
        {
            "name": "Baseline - PatchAlign3D",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["baseline", "patchalign3d"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
                "CC": "gcc-12",
                "CXX": "g++-12"
            }
        },
        {
            "name": "Baseline - PatchAlign3DRef",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["baseline", "patchalign3dref"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
                "CC": "gcc-12",
                "CXX": "g++-12"
            }
        },
        {
            "name": "Baseline - ULIP2Ref",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["baseline", "ulip2ref"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
                "CC": "gcc-12",
                "CXX": "g++-12"
            }
        },
        {
            "name": "Baseline - PaliGemma",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["baseline", "paligemma"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
            }
        },
        {
            "name": "Baseline - BT3D",
            "type": "debugpy",
            "request": "launch",
            "module": "zerokey",
            "args": ["baseline", "bt3d"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1"
            }
        },
        {
            "name": "Debug Gemma3",
            "type": "debugpy",
            "request": "launch",
            "program": "data_creation/gemma3.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
            }
        },
        {
            "name": "Debug Molmo",
            "type": "debugpy",
            "request": "launch",
            "program": "data_creation/molmo.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1"
            }
        },
        {
            "name": "Debug Pixmo Points",
            "type": "debugpy",
            "request": "launch",
            "program": "data_creation/pixmo-points.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1"
            }
        },
        {
            "name": "Debug Pali-Gemma",
            "type": "debugpy",
            "request": "launch",
            "program": "data_creation/pali_gemma.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
            }
        },
        {
            "name": "Download Data",
            "type": "debugpy",
            "request": "launch",
            "program": "molmo/scripts/download_data.py",
            "args": ["OkVqa", "--n_proc", "12"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Run MM Eval",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "args": [
                "--nproc_per_node=1",
                "--nnodes=1",
                "launch_scripts/eval_downstream.py",
                "pointing_eval",
                "--save_to_checkpoint_dir"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/molmo",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "PYTHONPATH": "${workspaceFolder}/molmo"
            }
        },
        {
            "name": "Run Multitask Training",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "args": [
                "--nproc_per_node=2",
                "--nnodes=1",
                "launch_scripts/train_multitask_model.py",
                "pointing",
                "--wandb=null",
                "--save_overwrite",
                "--global_batch_size=240",
                "--device_train_batch_size=1",
                "--device_eval_batch_size=1",
                "--device_inf_batch_size=1"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/molmo",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/molmo",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
                "OMP_NUM_THREADS": "12"
            }
        },
        {
            "name": "Run Multitask Training (No DDP)",
            "type": "debugpy",
            "request": "launch",
            "program": "launch_scripts/train_multitask_model.py",
            "args": [
                "pointing",
                "--wandb=null",
                "--save_overwrite",
                "--global_batch_size=240",
                "--device_train_batch_size=1",
                "--device_eval_batch_size=1",
                "--device_inf_batch_size=1"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/molmo",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_VISIBLE_DEVICES": "",
                "PYTHONPATH": "${workspaceFolder}/molmo",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
                "OMP_NUM_THREADS": "12"
            }
        }
    ]
}
